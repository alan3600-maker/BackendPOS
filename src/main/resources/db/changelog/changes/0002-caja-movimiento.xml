<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="0002-caja-movimiento" author="chatgpt">
    <createTable tableName="caja_movimiento">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="caja_turno_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="tipo" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>

      <column name="monto" type="DECIMAL(19,2)">
        <constraints nullable="false"/>
      </column>

      <column name="motivo" type="VARCHAR(300)"/>

      <column name="fecha" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>

      <column name="usuario_id" type="BIGINT"/>

      <!-- BaseEntity -->
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="caja_movimiento" baseColumnNames="caja_turno_id"
      referencedTableName="caja_turno" referencedColumnNames="id"
      constraintName="fk_caja_mov_turno"/>

    <addForeignKeyConstraint
      baseTableName="caja_movimiento" baseColumnNames="usuario_id"
      referencedTableName="usuario" referencedColumnNames="id"
      constraintName="fk_caja_mov_usuario"/>

    <createIndex tableName="caja_movimiento" indexName="idx_caja_mov_turno">
      <column name="caja_turno_id"/>
    </createIndex>

    <createIndex tableName="caja_movimiento" indexName="idx_caja_mov_fecha">
      <column name="fecha"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
